    NonUniform["EMVA1288.NonUniformity<br/>All fields Float<br/>dsnu_DN: DN; dsnu_e: electrons<br/>prnu_percent: percent<br/>deriving Repr"]
    Report["EMVA1288.Report<br/>params: SensorParams<br/>spatial: Option NonUniformity = none<br/>deriving Repr"]
